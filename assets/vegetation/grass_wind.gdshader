// Grass blades that sway in the wind.
//
// A shader is a small program that runs on the GPU. A "spatial" shader has
// two main stages:
//   vertex()   runs once per vertex and can move it. We bend the blades here.
//   fragment() runs once per pixel and decides its colour.
// The grass mesh is generated by tools/build_world.gd, which stores each
// vertex's height along its blade in UV.y (0 = root, 1 = tip).
shader_type spatial;
render_mode cull_disabled; // blades are flat, so draw both sides

uniform vec3 base_color : source_color = vec3(0.07, 0.14, 0.04);
uniform vec3 tip_color : source_color = vec3(0.42, 0.52, 0.18);
uniform vec3 dry_tint : source_color = vec3(0.55, 0.50, 0.22);
uniform float wind_strength = 0.15;  // how far the tips move, in metres
uniform float wind_speed = 1.3;
uniform vec2 wind_direction = vec2(1.0, 0.35);
uniform float gust_size = 12.0;      // metres between gust wave crests

varying float tip;      // 0 at the root, 1 at the tip
varying float dryness;  // per-patch colour variation

void vertex() {
	tip = UV.y;
	// MODEL_MATRIX is this instance's transform (each clump has its own),
	// so world_pos is where this vertex is in the world.
	vec3 world_pos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;

	// A slow wave rolling across the field, plus a faster flutter.
	vec2 dir = normalize(wind_direction);
	float gust = sin(TIME * wind_speed - dot(world_pos.xz, dir) * 6.2832 / gust_size) * 0.5 + 0.5;
	float flutter = sin(TIME * wind_speed * 3.7 + world_pos.x * 1.9 + world_pos.z * 2.3) * 0.3;
	// tip * tip: roots stay planted, tips move the most.
	vec2 sway = dir * (gust + flutter) * wind_strength * tip * tip;

	// The sway is in world space, but VERTEX is in the mesh's local space,
	// so convert with the inverse of the instance's rotation and scale.
	mat3 to_local = inverse(mat3(MODEL_MATRIX));
	VERTEX += to_local * vec3(sway.x, -0.3 * length(sway), sway.y);

	// Make every blade face "up" for lighting. Real blades are thin and
	// translucent, and per-blade normals make a field look noisy and dark.
	NORMAL = normalize(to_local * vec3(0.0, 1.0, 0.0));

	// Large, soft patches of drier grass. Cheap noise from sines.
	dryness = smoothstep(0.3, 1.0, sin(world_pos.x * 0.05) * sin(world_pos.z * 0.043 + 1.7) + 0.4);
}

void fragment() {
	vec3 tip_col = mix(tip_color, dry_tint, dryness * 0.6);
	ALBEDO = mix(base_color, tip_col, tip);
	ROUGHNESS = 0.85;
	SPECULAR = 0.25;
	// Light shining through the blades from behind (subsurface-like glow).
	BACKLIGHT = vec3(0.35, 0.4, 0.15) * tip;
	// Darken the roots: fake occlusion from neighbouring blades.
	AO = mix(0.35, 1.0, tip);
	AO_LIGHT_AFFECT = 0.6;
}
