[node name="Mannequin" type="Node3D"]
editor_description = "Every mesh except the arms is on render layer 2, which the first-person camera hides (you still see your shadow). HandSocket (under ElbowR) holds carried items; HandSocketL (under ElbowL) holds the equipped weapon/tool. Greybox humanoid, 1.8 m, feet at the origin, facing -Z. Pivot nodes (Hips, Spine, ShoulderL/R, ElbowL/R, HipL/R, KneeL/R) act as joints; mannequin.gd rotates them to animate. Meshes are children of the pivots, offset so they hang from the joint."
script = ExtResource("1_mq")

