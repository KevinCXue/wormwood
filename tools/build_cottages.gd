extends SceneTree
## Builds villagers' cottages: one-storey, timber-framed, with a bed, a table
## and a lantern inside. One variant per entry in VARIANTS, each written to
## res://buildings/<name>.tscn. They share a layout and differ in colours, so
## a row of them doesn't look copy-pasted.
##
## Run from the project folder (after tools/build_props.gd, which makes the
## furniture and items it uses):
##   <Godot binary> --headless --path . -s res://tools/build_cottages.gd
##
## WARNING: overwrites res://buildings/cottage_*.tscn. Place and rotate
## cottages in village/village.tscn rather than editing these files.
##
## Layout (cottage-local metres; origin = ground centre, door faces +Z):
##   Footprint 7 x 6, walls 0.3 thick and 3.3 tall, gable roof. Bed in the
##   back-right corner, table on the left, lantern on a nightstand.
## Same building blocks as tools/build_house.gd: CSG boxes added and cut in
## tree order, with use_collision on.

const W := 7.0   # width (X)
const D := 6.0   # depth (Z)
const T := 0.3   # wall thickness
const H := 3.3   # wall height
const OUT_DIR := "res://buildings"

# name -> [plaster, timber, roof]
const VARIANTS := {
	"cottage_a": [Color(0.82, 0.8, 0.74), Color(0.22, 0.2, 0.2), Color(0.28, 0.32, 0.38)],  # pale, slate roof
	"cottage_b": [Color(0.8, 0.68, 0.48), Color(0.3, 0.2, 0.12), Color(0.5, 0.4, 0.22)],   # ochre, thatch-coloured roof
}

var cottage: Node3D
var shell: CSGCombiner3D
var timber: StandardMaterial3D


func _initialize() -> void:
	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(OUT_DIR))
	for variant in VARIANTS:
		var colours: Array = VARIANTS[variant]
		_build(variant, colours[0], colours[1], colours[2])
		print("wrote %s/%s.tscn" % [OUT_DIR, variant])
	quit()


func _build(variant: String, plaster_color: Color, timber_color: Color, roof_color: Color) -> void:
	var plaster := _mat(plaster_color, 0.95)
	timber = _mat(timber_color, 0.9)
	var boards := _mat(Color(0.45, 0.32, 0.2), 0.85)

	cottage = Node3D.new()
	cottage.name = variant.to_pascal_case()
	cottage.editor_description = "Generated by tools/build_cottages.gd (re-running it overwrites this file). Door faces +Z. The 'footprint' metadata (width, depth in metres) tells tools/build_village.gd how much ground to clear."
	# Metadata: arbitrary key/value data stored on any node (Inspector >
	# Metadata). The village tool reads this instead of guessing sizes.
	cottage.set_meta("footprint", Vector2(W, D))

	shell = CSGCombiner3D.new()
	shell.name = "Shell"
	shell.use_collision = true
	_add(cottage, shell)
	_csg_box("Outer", Vector3(W, H, D), Vector3(0, H / 2, 0), plaster)
	_csg_box("Hollow", Vector3(W - 2 * T, H - 0.1, D - 2 * T), Vector3(0, (H - 0.3) / 2, 0), plaster, true)
	for sx in [-1, 1]:
		for sz in [-1, 1]:
			_csg_box("Post", Vector3(0.3, H, 0.3), Vector3(sx * (W / 2 - 0.1), H / 2, sz * (D / 2 - 0.1)), timber)
	for sz in [-1, 1]:
		_csg_box("Beam", Vector3(W + 0.1, 0.22, 0.12), Vector3(0, H - 0.15, sz * (D / 2 + 0.01)), timber)

	_opening("Door", "front", 0.0, 1.2, Vector2(1.4, 2.3))
	var win := Vector2(0.9, 1.0)
	for x in [-2.2, 2.2]:
		_opening("Window", "front", x, 1.6, win)
	_opening("Window", "back", 0.0, 1.6, win)
	_opening("Window", "left", 0.0, 1.6, win)
	_opening("Window", "right", 0.6, 1.6, win)

	var roof := CSGMesh3D.new()
	roof.name = "Roof"
	var prism := PrismMesh.new()  # triangle in X/Y, stretched along Z: the ridge runs front to back
	prism.size = Vector3(W + 0.8, 2.2, D + 0.8)
	roof.mesh = prism
	roof.material = _mat(roof_color, 0.9)
	roof.position = Vector3(0, H + 1.1 - 0.01, 0)
	_add(shell, roof)

	var floor_mesh := PlaneMesh.new()
	floor_mesh.size = Vector2(W - 2 * T, D - 2 * T)
	floor_mesh.material = boards
	var floor_mi := MeshInstance3D.new()
	floor_mi.name = "FloorBoards"
	floor_mi.mesh = floor_mesh
	floor_mi.position.y = 0.01
	_add(cottage, floor_mi)

	_furnish()
	_pack(cottage, "%s/%s.tscn" % [OUT_DIR, variant])


func _furnish() -> void:
	# Bed in the back-right corner, headboard (+X) against the right wall
	# (same orientation as in the big house).
	_place("res://props/furniture/bed.tscn", Vector3(W / 2 - T - 1.04, 0, -D / 2 + T + 0.55))
	var nightstand := _place("res://props/furniture/nightstand.tscn", Vector3(W / 2 - T - 0.3, 0, -D / 2 + T + 1.45))
	# A lantern, so the windows glow at night.
	_place("res://props/items/lantern.tscn", nightstand.position + Vector3(0, _top(nightstand) + 0.02, 0))
	var table := _place("res://props/tables/small_table.tscn", Vector3(-W / 2 + T + 0.9, 0, -0.3))
	var top := _top(table)
	_place("res://props/items/candle.tscn", table.position + Vector3(0.1, top + 0.02, 0.05))
	_place("res://props/items/bowl.tscn", table.position + Vector3(-0.15, top + 0.02, -0.1))
	_place("res://props/furniture/chest.tscn", Vector3(-W / 2 + T + 0.6, 0, -D / 2 + T + 0.45), 90.0)


# --- Helpers (as in build_house.gd) ----------------------------------------------

## A framed opening in one wall. `along` is the position along that wall
## (X for front/back, Z for left/right), `y` the centre height.
func _opening(kind: String, face: String, along: float, y: float, size: Vector2) -> void:
	var on_x := face == "left" or face == "right"  # wall runs along Z
	var sign := 1.0 if face == "front" or face == "right" else -1.0
	var centre := Vector3(sign * W / 2, y, along) if on_x else Vector3(along, y, sign * D / 2)
	var frame := Vector3(T + 0.12, size.y + 0.16, size.x + 0.16) if on_x else Vector3(size.x + 0.16, size.y + 0.16, T + 0.12)
	var hole := Vector3(T + 0.6, size.y, size.x) if on_x else Vector3(size.x, size.y, T + 0.6)
	if kind == "Door":
		centre.y = size.y / 2 - 0.05  # down to (just below) the ground
		hole.y += 0.1
	_csg_box(kind + "Frame", frame, centre + Vector3(0, 0.03 if kind == "Door" else 0.0, 0), timber)
	_csg_box(kind, hole, centre, timber, true)


func _csg_box(box_name: String, size: Vector3, pos: Vector3, material: Material, subtract := false) -> void:
	var box := CSGBox3D.new()
	box.name = box_name
	box.size = size
	box.position = pos
	box.material = material
	if subtract:
		box.operation = CSGShape3D.OPERATION_SUBTRACTION
	_add(shell, box)


func _place(scene_path: String, pos: Vector3, yaw_deg := 0.0) -> Node3D:
	var node: Node3D = load(scene_path).instantiate()
	node.position = pos
	node.rotation.y = deg_to_rad(yaw_deg)
	_add(cottage, node)
	return node


## Height of a piece of furniture's top surface above its base.
func _top(node: Node3D) -> float:
	var mi := node.get_node_or_null("Mesh") as MeshInstance3D
	if mi:
		return mi.mesh.get_aabb().end.y
	return 0.6


func _add(parent: Node, child: Node) -> void:
	parent.add_child(child, true)  # true = number duplicate names (Window2, Window3...)


func _mat(color: Color, roughness: float) -> StandardMaterial3D:
	var m := StandardMaterial3D.new()
	m.albedo_color = color
	m.roughness = roughness
	return m


func _pack(root_node: Node, path: String) -> void:
	_set_owner(root_node, root_node)
	var scene := PackedScene.new()
	scene.pack(root_node)
	var err := ResourceSaver.save(scene, path)
	assert(err == OK, "failed to save " + path)
	root_node.free()


## Every node we created must be "owned" by the root to be saved in the scene.
## Nodes inside instanced scenes (furniture, items) belong to those scenes.
func _set_owner(node: Node, owner_node: Node) -> void:
	for c in node.get_children():
		c.owner = owner_node
		if c.scene_file_path == "":
			_set_owner(c, owner_node)
