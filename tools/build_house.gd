extends SceneTree
## Builds res://house.tscn: a two-storey timber-framed house with windows,
## a staircase, a dining room downstairs and a bedroom upstairs, lit by
## lanterns and candles.
##
## Run from the project folder (after tools/build_props.gd, which makes the
## furniture and light items it uses):
##   <Godot binary> --headless --path . -s res://tools/build_house.gd
##
## WARNING: overwrites res://house.tscn.
##
## Layout (house-local metres; origin = ground centre, front door faces +Z):
##   Footprint 10 x 8, walls 0.3 thick, upper floor at 3.1 m, walls 6.2 m tall.
##   Stairs along the left (-X) wall, rising from the front (z +2.6) to the
##   back (z -1.6). Dining table in the middle-right, sideboard on the back
##   wall. Upstairs: bed in the back-right corner, nightstand, chest.

const W := 10.0       # width (X)
const D := 8.0        # depth (Z)
const T := 0.3        # wall thickness
const H := 6.2        # wall height
const FLOOR2 := 3.1   # top of the upper floor
const SLAB := 0.2     # upper floor thickness
# Stairs: footprint along the left wall.
const STAIR_X0 := -W / 2 + T          # -4.7 (against the wall)
const STAIR_W := 1.2
const STAIR_Z_BOTTOM := 2.6
const STAIR_Z_TOP := -1.6
const STEPS := 16

var plaster := _mat(Color(0.8, 0.75, 0.64), 0.95)
var timber := _mat(Color(0.26, 0.17, 0.11), 0.9)
var boards := _mat(Color(0.45, 0.32, 0.2), 0.85)
var roof_mat := _mat(Color(0.4, 0.2, 0.15), 0.9)

var house: Node3D
var shell: CSGCombiner3D


func _initialize() -> void:
	house = Node3D.new()
	house.name = "House"
	house.editor_description = "Generated by tools/build_house.gd (re-running it overwrites this file). Shell is CSG: boxes added and subtracted in tree order, with use_collision on. The stairs collide via an invisible ramp (Stairs/Ramp) so walking up them is smooth."
	_build_shell()
	_build_stairs()
	_build_railing()
	_build_ground_floor()
	_build_upper_floor()
	_pack(house, "res://house.tscn")
	print("done")
	quit()


# --- Walls, floors, roof ---------------------------------------------------------

func _build_shell() -> void:
	shell = CSGCombiner3D.new()
	shell.name = "Shell"
	shell.use_collision = true
	_add(house, shell)

	_csg_box("Outer", Vector3(W, H, D), Vector3(0, H / 2, 0), plaster)
	# Hollow from just below the ground to 0.2 below the top (= the ceiling).
	_csg_box("Hollow", Vector3(W - 2 * T, H - 0.1, D - 2 * T), Vector3(0, (H - 0.3) / 2, 0), plaster, true)
	_csg_box("UpperFloor", Vector3(W - 2 * T, SLAB, D - 2 * T), Vector3(0, FLOOR2 - SLAB / 2, 0), boards)
	var hole_len := STAIR_Z_BOTTOM - STAIR_Z_TOP + 0.2
	_csg_box("StairHole", Vector3(STAIR_W + 0.1, SLAB + 0.2, hole_len),
		Vector3(STAIR_X0 + (STAIR_W + 0.1) / 2, FLOOR2 - SLAB / 2, (STAIR_Z_BOTTOM + STAIR_Z_TOP) / 2 + 0.05), boards, true)

	# Timber framing on the outside: corner posts and a beam at the upper floor.
	for sx in [-1, 1]:
		for sz in [-1, 1]:
			_csg_box("Post", Vector3(0.36, H, 0.36), Vector3(sx * (W / 2 - 0.12), H / 2, sz * (D / 2 - 0.12)), timber)
	for sz in [-1, 1]:
		_csg_box("Beam", Vector3(W + 0.1, 0.25, 0.12), Vector3(0, FLOOR2, sz * (D / 2 + 0.01)), timber)
	for sx in [-1, 1]:
		_csg_box("Beam", Vector3(0.12, 0.25, D + 0.1), Vector3(sx * (W / 2 + 0.01), FLOOR2, 0), timber)

	# Door (front, +Z) and windows: a timber frame added first, then the
	# opening cut through both frame and wall.
	_opening("Door", "front", 0.0, 1.2, Vector2(1.6, 2.4))
	var win := Vector2(1.0, 1.2)
	var low := 1.6               # window centre height, ground floor
	var high := FLOOR2 + 1.7     # upper floor
	for x in [-3.0, 3.0]:
		_opening("Window", "front", x, low, win)
	for x in [-3.0, 0.0, 3.0]:
		_opening("Window", "front", x, high, win)
	for x in [-2.5, 2.5]:
		_opening("Window", "back", x, low, win)
		_opening("Window", "back", x, high, win)
	_opening("Window", "right", 0.0, low, win)
	_opening("Window", "right", 0.0, high, win)
	_opening("Window", "left", 0.0, high, win)  # none below: the stairs run along that wall

	# Pitched roof: a triangular prism whose ridge runs front to back.
	var roof := CSGMesh3D.new()
	roof.name = "Roof"
	var prism := PrismMesh.new()
	prism.size = Vector3(W + 0.8, 2.4, D + 0.8)
	roof.mesh = prism
	roof.material = roof_mat
	roof.position = Vector3(0, H + 1.2 - 0.01, 0)
	_add(shell, roof)

	# Ground-floor boards (just a visual on top of the terrain).
	var floor_mesh := PlaneMesh.new()
	floor_mesh.size = Vector2(W - 2 * T, D - 2 * T)
	floor_mesh.material = boards
	var floor_mi := MeshInstance3D.new()
	floor_mi.name = "GroundFloorBoards"
	floor_mi.mesh = floor_mesh
	floor_mi.position.y = 0.01
	_add(house, floor_mi)


## A framed opening in one wall. `along` is the position along that wall
## (X for front/back, Z for left/right), `y` the centre height.
func _opening(kind: String, face: String, along: float, y: float, size: Vector2) -> void:
	var on_x := face == "left" or face == "right"  # wall runs along Z
	var sign := 1.0 if face == "front" or face == "right" else -1.0
	var centre := Vector3(sign * W / 2, y, along) if on_x else Vector3(along, y, sign * D / 2)
	var frame := Vector3(T + 0.12, size.y + 0.16, size.x + 0.16) if on_x else Vector3(size.x + 0.16, size.y + 0.16, T + 0.12)
	var hole := Vector3(T + 0.6, size.y, size.x) if on_x else Vector3(size.x, size.y, T + 0.6)
	if kind == "Door":
		centre.y = size.y / 2 - 0.05  # down to (just below) the ground
		hole.y += 0.1
	_csg_box(kind + "Frame", frame, centre + Vector3(0, 0.03 if kind == "Door" else 0.0, 0), timber)
	_csg_box(kind, hole, centre, timber, true)


func _csg_box(box_name: String, size: Vector3, pos: Vector3, material: Material, subtract := false) -> void:
	var box := CSGBox3D.new()
	box.name = box_name
	box.size = size
	box.position = pos
	box.material = material
	if subtract:
		box.operation = CSGShape3D.OPERATION_SUBTRACTION
	_add(shell, box)


# --- Stairs ----------------------------------------------------------------------

func _build_stairs() -> void:
	var stairs := Node3D.new()
	stairs.name = "Stairs"
	_add(house, stairs)
	var run := STAIR_Z_BOTTOM - STAIR_Z_TOP
	var rise := FLOOR2 / STEPS
	var tread := run / STEPS
	var x := STAIR_X0 + STAIR_W / 2

	# Visual: solid stacked steps, merged into one mesh.
	var st := SurfaceTool.new()
	for i in STEPS:
		var box := BoxMesh.new()
		box.size = Vector3(STAIR_W, rise * (i + 1), tread)
		st.append_from(box, 0, Transform3D(Basis(), Vector3(x, rise * (i + 1) / 2, STAIR_Z_BOTTOM - tread * (i + 0.5))))
	st.set_material(boards)
	var mi := MeshInstance3D.new()
	mi.name = "Steps"
	mi.mesh = st.commit()
	_add(stairs, mi)

	# Collision: an invisible ramp along the step edges. CharacterBody3D
	# can't climb steps on its own, but it walks up slopes under 45 degrees.
	var angle := atan2(FLOOR2, run)  # ~36 degrees
	var length := sqrt(run * run + FLOOR2 * FLOOR2)
	var ramp := StaticBody3D.new()
	ramp.name = "Ramp"
	var shape := CollisionShape3D.new()
	shape.shape = BoxShape3D.new()
	# 0.3 m longer than the slope, all of it at the bottom (sunk into the
	# ground), so the top meets the upper floor without a lip.
	shape.shape.size = Vector3(STAIR_W, 0.2, length + 0.3)
	# Tilt around X so the box's -Z end rises towards the back of the house.
	var basis := Basis(Vector3.RIGHT, angle)
	var mid := Vector3(x, FLOOR2 / 2, (STAIR_Z_BOTTOM + STAIR_Z_TOP) / 2)
	mid += basis.z * 0.15  # basis.z points down the slope
	shape.transform = Transform3D(basis, mid - basis.y * 0.1)  # top face on the step edges
	ramp.add_child(shape)
	# The steps are a solid block, but the ramp is only a thin plank along
	# their top, so from behind or the open side you'd walk straight into the
	# block. Fill it with a wedge (a triangular prism): flat on the ground, a
	# vertical back face where the steps reach the upper floor, and a slope
	# from the bottom step to the top, just under the ramp.
	var wedge := CollisionShape3D.new()
	wedge.name = "Block"
	var prism := ConvexPolygonShape3D.new()
	var points := PackedVector3Array()
	for side in [STAIR_X0, STAIR_X0 + STAIR_W]:
		points.append(Vector3(side, 0.0, STAIR_Z_BOTTOM))  # bottom front edge
		points.append(Vector3(side, 0.0, STAIR_Z_TOP))     # bottom back corner
		points.append(Vector3(side, FLOOR2, STAIR_Z_TOP))  # top back corner
	prism.points = points
	wedge.shape = prism
	ramp.add_child(wedge)
	_add(stairs, ramp)


## A railing upstairs around the stair opening, so you can't fall in.
func _build_railing() -> void:
	var rail := StaticBody3D.new()
	rail.name = "StairRailing"
	_add(house, rail)
	var x_edge := STAIR_X0 + STAIR_W + 0.08
	var z_front := STAIR_Z_BOTTOM + 0.15
	var z_back := STAIR_Z_TOP
	# Long side (along Z) and short side (along X), each: top rail + posts + collision.
	_rail_segment(rail, Vector3(x_edge, 0, z_back), Vector3(x_edge, 0, z_front))
	_rail_segment(rail, Vector3(STAIR_X0, 0, z_front), Vector3(x_edge, 0, z_front))


func _rail_segment(rail: StaticBody3D, a: Vector3, b: Vector3) -> void:
	var length := a.distance_to(b)
	var along := (b - a).normalized()
	var mid := (a + b) / 2 + Vector3(0, FLOOR2, 0)
	var basis := Basis.looking_at(along) if length > 0.01 else Basis()  # -Z along the rail
	var st := SurfaceTool.new()
	var top := BoxMesh.new()
	top.size = Vector3(0.07, 0.07, length)
	st.append_from(top, 0, Transform3D(basis, mid + Vector3(0, 0.95, 0)))
	var posts := int(length / 0.7) + 1
	for i in posts + 1:
		var p := a.lerp(b, float(i) / posts) + Vector3(0, FLOOR2 + 0.47, 0)
		var post := BoxMesh.new()
		post.size = Vector3(0.06, 0.94, 0.06)
		st.append_from(post, 0, Transform3D(Basis(), p))
	st.set_material(timber)
	var mi := MeshInstance3D.new()
	mi.mesh = st.commit()
	rail.add_child(mi)
	var shape := CollisionShape3D.new()
	shape.shape = BoxShape3D.new()
	shape.shape.size = Vector3(0.1, 1.0, length)
	shape.transform = Transform3D(basis, mid + Vector3(0, 0.5, 0))
	rail.add_child(shape)


# --- Furniture and lights ----------------------------------------------------------

func _build_ground_floor() -> void:
	var table := _place("res://props/furniture/dining_table.tscn", Vector3(1.6, 0, 0.3))
	var top := _top(table)
	# Benches along both long sides, backs turned away from the table.
	for side in [-1, 1]:
		_place_bench(Vector3(1.6, 0, 0.3 + side * 1.0), side)
	_place("res://props/furniture/cabinet.tscn", Vector3(2.6, 0, -D / 2 + T + 0.3))
	# Things on the table: two candles, a jug, goblets, plates.
	for item in [["candle", Vector3(1.0, 0, 0.3)], ["candle", Vector3(2.2, 0, 0.3)],
			["jug", Vector3(1.6, 0, 0.35)], ["goblet", Vector3(1.25, 0, 0.65)],
			["goblet", Vector3(1.95, 0, -0.05)], ["plate", Vector3(1.25, 0, -0.05)],
			["plate", Vector3(1.95, 0, 0.65)]]:
		_place("res://props/items/%s.tscn" % item[0], item[1] + Vector3(0, top + 0.02, 0))
	# A lantern on the sideboard, and one on a small shelf by the door.
	var cabinet_top := 1.2
	_place("res://props/items/lantern.tscn", Vector3(2.2, cabinet_top + 0.02, -D / 2 + T + 0.3))
	var shelf_pos := Vector3(-1.6, 1.7, D / 2 - T - 0.13)
	_shelf(shelf_pos)
	_place("res://props/items/lantern.tscn", shelf_pos + Vector3(0, 0.04, 0))


func _build_upper_floor() -> void:
	var y := FLOOR2
	# Bed in the back-right corner, headboard (+X) against the right wall.
	_place("res://props/furniture/bed.tscn", Vector3(W / 2 - T - 1.04, y, -D / 2 + T + 0.55))
	var nightstand := _place("res://props/furniture/nightstand.tscn", Vector3(W / 2 - T - 0.3, y, -D / 2 + T + 1.45))
	_place("res://props/items/candle.tscn", nightstand.position + Vector3(0, _top(nightstand) + 0.02, 0))
	# A chest at the foot of the bed, with a lantern on it.
	var chest := _place("res://props/furniture/chest.tscn", Vector3(1.85, y, -D / 2 + T + 0.55), 90.0)
	_place("res://props/items/lantern.tscn", chest.position + Vector3(0, _top(chest) + 0.02, 0))


## Benches have a backrest on one side. Find which side from the mesh (where
## the high vertices are), then turn it so the back faces away from the table.
func _place_bench(pos: Vector3, side: int) -> void:
	var mesh: Mesh = load("res://assets/models/painted_wooden_bench/painted_wooden_bench_merged.res")
	var z_sum := 0.0
	var count := 0
	for s in mesh.get_surface_count():
		for v in mesh.surface_get_arrays(s)[Mesh.ARRAY_VERTEX]:
			if v.y > 0.6:
				z_sum += v.z
				count += 1
	var back_is_plus_z: bool = z_sum / maxi(count, 1) > 0.0
	# Bench at side +1 sits at larger Z, so its back should face +Z.
	var want_plus_z := side > 0
	var yaw := 0.0 if back_is_plus_z == want_plus_z else 180.0
	_place("res://props/furniture/bench.tscn", pos, yaw)


func _shelf(pos: Vector3) -> void:
	var shelf := StaticBody3D.new()
	shelf.name = "Shelf"
	var mi := MeshInstance3D.new()
	var box := BoxMesh.new()
	box.size = Vector3(0.5, 0.05, 0.26)
	box.material = timber
	mi.mesh = box
	shelf.add_child(mi)
	var shape := CollisionShape3D.new()
	shape.shape = BoxShape3D.new()
	shape.shape.size = box.size
	shelf.add_child(shape)
	shelf.position = pos
	_add(house, shelf)


func _place(scene_path: String, pos: Vector3, yaw_deg := 0.0) -> Node3D:
	var node: Node3D = load(scene_path).instantiate()
	node.position = pos
	node.rotation.y = deg_to_rad(yaw_deg)
	_add(house, node)
	return node


## Height of a piece of furniture's top surface above its base.
func _top(node: Node3D) -> float:
	var mi := node.get_node_or_null("Mesh") as MeshInstance3D
	if mi:
		return mi.mesh.get_aabb().end.y
	return 0.6


# --- Helpers -----------------------------------------------------------------------

func _add(parent: Node, child: Node) -> void:
	parent.add_child(child, true)  # true = number duplicate names (Window2, Window3...)


func _mat(color: Color, roughness: float) -> StandardMaterial3D:
	var m := StandardMaterial3D.new()
	m.albedo_color = color
	m.roughness = roughness
	return m


func _pack(root_node: Node, path: String) -> void:
	_set_owner(root_node, root_node)
	var scene := PackedScene.new()
	scene.pack(root_node)
	var err := ResourceSaver.save(scene, path)
	assert(err == OK, "failed to save " + path)
	root_node.free()


## Every node we created must be "owned" by the root to be saved in the scene.
## Nodes inside instanced scenes (furniture, items) belong to those scenes.
func _set_owner(node: Node, owner_node: Node) -> void:
	for c in node.get_children():
		c.owner = owner_node
		if c.scene_file_path == "":
			_set_owner(c, owner_node)
