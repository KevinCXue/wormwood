extends SceneTree
## Builds res://places/mushroom_cave.tscn: a small cave in the woods, home
## of the mushrooms for Tobin's quest ("Suspicious Stew").
##
## Run from the project folder (after tools/build_props.gd, which makes the
## mushroom item):
##   <Godot binary> --headless --path . -s res://tools/build_cave.gd
##
## WARNING: overwrites places/mushroom_cave.tscn. Place and turn the cave in
## village/village.tscn (under Wilds) rather than editing the scene.
##
## Shape: a lumpy rock dome, hollowed out, with a ragged arch through its
## front (+Z): a stretched sphere cut through the wall, roughened by a few
## smaller cuts around its rim, under a couple of overhanging rocks. It's CSG, as the buildings are: shapes added
## and subtracted in tree order, with collision on. The ground inside is the
## terrain, flattened by tools/build_village.gd thanks to the "footprint"
## metadata, under a rocky floor disc. Boulders around the outside break up
## the dome's outline. Inside: glowing mushrooms (items you can take), more
## than the quest needs, and two dim green lights.
##
## Conventions: metres, origin = ground centre, entrance faces +Z.

const OUT := "res://places/mushroom_cave.tscn"
const RADIUS := 8.0        # outer dome radius
const WALL := 1.3          # rock thickness
const SQUASH := 0.7        # dome height / width
const ARCH := Vector2(1.5, 2.6)  # entrance half-width and height (metres)
const MUSHROOM_SPOTS := 9  # clumps; a pair counts as 2 (the quest needs 5)

var rng := RandomNumberGenerator.new()
var rock: StandardMaterial3D
var root_node: Node3D
var shell: CSGCombiner3D


func _initialize() -> void:
	rng.seed = 7  # the same cave every run
	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(OUT.get_base_dir()))
	rock = _rock_material()
	root_node = Node3D.new()
	root_node.name = "MushroomCave"
	root_node.editor_description = "Generated by tools/build_cave.gd (re-running it overwrites this file). Entrance faces +Z. The 'footprint' metadata tells tools/build_village.gd how much ground to flatten and clear."
	root_node.set_meta("footprint", Vector2(RADIUS * 2.0 + 2.0, RADIUS * 2.0 + 2.0))
	_build_shell()
	_build_floor()
	_build_boulders()
	_build_lights()
	_place_mushrooms()
	_pack()
	print("wrote ", OUT)
	quit()


func _build_shell() -> void:
	shell = CSGCombiner3D.new()
	shell.name = "Shell"
	shell.use_collision = true
	_add(root_node, shell)
	# The dome, plus a few lumps so it isn't a perfect bowl.
	_sphere("Dome", RADIUS, Vector3.ZERO, Vector3(1.0, SQUASH, 1.1))
	for i in 7:
		var a := rng.randf_range(0.0, TAU)
		if absf(wrapf(a - PI / 2.0, -PI, PI)) < 0.6:
			continue  # keep the front (+Z, angle PI/2 in this sin/cos) clear
		var r := rng.randf_range(2.5, 4.0)
		var at := Vector3(cos(a) * (RADIUS - 2.0), rng.randf_range(0.5, 2.5), sin(a) * (RADIUS - 2.0))
		_sphere("Lump", r, at, Vector3(1.0, rng.randf_range(0.7, 1.0), 1.0))
	# Hollow it out, leaving WALL of rock, then cut the tunnel.
	_sphere("Hollow", RADIUS - WALL, Vector3(0, -0.4, 0), Vector3(1.0, SQUASH, 1.1), true)
	# The entrance: a sphere stretched into an arch, centred at ground level so
	# only its top half cuts the wall, long enough (Z) to go right through.
	var front := RADIUS * 1.1
	_sphere("Arch", 1.0, Vector3(0, 0, front - 0.6), Vector3(ARCH.x, ARCH.y, 3.2), true)
	# Smaller bites around the rim, so the edge isn't a clean curve.
	for i in 5:
		var a := lerpf(0.25, PI - 0.25, float(i) / 4.0) + rng.randf_range(-0.15, 0.15)
		var rim := Vector3(cos(a) * ARCH.x, sin(a) * ARCH.y, front - 0.2)
		_sphere("ArchBite", rng.randf_range(0.45, 0.8), rim, Vector3(1.0, 1.0, 1.6), true)


func _sphere(sphere_name: String, radius: float, pos: Vector3, squash: Vector3, subtract := false) -> void:
	var s := CSGSphere3D.new()
	s.name = sphere_name
	s.radius = radius
	s.radial_segments = 14  # few faces, so it reads as rough rock...
	s.rings = 9
	s.smooth_faces = false  # ...with hard edges between them
	s.position = pos
	s.scale = squash
	s.material = rock
	if subtract:
		s.operation = CSGShape3D.OPERATION_SUBTRACTION
	_add(shell, s)


## Rough rock floor over the (flattened) terrain inside, so the terrain's
## grass texture doesn't show in the cave.
func _build_floor() -> void:
	var disc := CylinderMesh.new()
	disc.top_radius = RADIUS - WALL - 0.2
	disc.bottom_radius = disc.top_radius
	disc.height = 0.06
	disc.radial_segments = 24
	disc.material = rock
	var floor_mi := MeshInstance3D.new()
	floor_mi.name = "Floor"
	floor_mi.mesh = disc
	floor_mi.position.y = 0.02
	_add(root_node, floor_mi)


## Boulders (the terrain's rock model, scaled up) half-buried around the dome.
func _build_boulders() -> void:
	var mesh: Mesh = load("res://assets/models/rock_07/rock_07.res")
	var shape := mesh.create_convex_shape(true, true)
	for i in 10:
		var a := rng.randf_range(0.0, TAU)
		if absf(wrapf(a - PI / 2.0, -PI, PI)) < 0.7:
			continue  # not in front of the entrance
		var body := StaticBody3D.new()
		body.name = "Boulder"
		var s := rng.randf_range(9.0, 16.0)
		body.scale = Vector3.ONE * s
		body.position = Vector3(cos(a) * (RADIUS + 0.5), rng.randf_range(-0.5, 0.8), sin(a) * (RADIUS + 0.5))
		body.rotation = Vector3(rng.randf_range(-0.4, 0.4), rng.randf_range(0, TAU), rng.randf_range(-0.4, 0.4))
		var mi := MeshInstance3D.new()
		mi.name = "Mesh"
		mi.mesh = mesh
		body.add_child(mi)
		var cs := CollisionShape3D.new()
		cs.name = "Collision"
		cs.shape = shape
		body.add_child(cs)
		_add(root_node, body)
	# Rocks framing the entrance: one low on each side, and two jutting out
	# over the top of the arch.
	var frame := [[Vector3(-(ARCH.x + 1.0), 0.0, RADIUS * 1.1 + 0.4), 8.0],
		[Vector3(ARCH.x + 1.1, 0.0, RADIUS * 1.1 + 0.3), 7.0],
		# Over the arch, set back where the dome curves away, so they sit in it.
		[Vector3(-0.7, ARCH.y + 0.1, RADIUS * 1.1 - 1.5), 7.5],
		[Vector3(0.9, ARCH.y - 0.1, RADIUS * 1.1 - 1.3), 6.0]]
	for spec in frame:
		var body := StaticBody3D.new()
		body.name = "EntranceBoulder"
		body.scale = Vector3.ONE * spec[1]
		body.position = spec[0]
		body.rotation.y = rng.randf_range(0, TAU)
		var mi := MeshInstance3D.new()
		mi.name = "Mesh"
		mi.mesh = mesh
		body.add_child(mi)
		var cs := CollisionShape3D.new()
		cs.name = "Collision"
		cs.shape = shape
		body.add_child(cs)
		_add(root_node, body)


## Dim, cool light inside, as if from the mushrooms, so it's eerie but not
## pitch dark (the town's MIN_LIGHT idea, kept low on purpose).
func _build_lights() -> void:
	for at in [Vector3(-2.0, 1.4, -1.5), Vector3(2.2, 1.2, 1.0)]:
		var light := OmniLight3D.new()
		light.name = "Glow"
		light.light_color = Color(0.55, 0.95, 0.65)
		light.light_energy = 1.6
		light.omni_range = 6.5
		light.shadow_enabled = false
		light.position = at
		_add(root_node, light)


## Mushrooms around the floor, away from the entrance: a random mix of the
## four shapes (small, medium, large, pairs). They're ordinary items placed
## in the scene, so taking them is saved like any other item.
func _place_mushrooms() -> void:
	var kinds := [["mushroom", 3], ["mushroom_small", 3], ["mushroom_large", 2], ["mushroom_pair", 2]]
	var bag := []  # each kind repeated by its weight, to pick from at random
	for k in kinds:
		for i in k[1]:
			bag.append(load("res://props/items/%s.tscn" % k[0]))
	var placed := 0
	var tries := 0
	while placed < MUSHROOM_SPOTS and tries < 200:
		tries += 1
		var a := rng.randf_range(0.0, TAU)
		if absf(wrapf(a - PI / 2.0, -PI, PI)) < 0.8:
			continue  # not in the tunnel
		var r := rng.randf_range(2.0, RADIUS - WALL - 1.2)
		var m: Node3D = bag[rng.randi() % bag.size()].instantiate()
		m.position = Vector3(cos(a) * r, 0.06, sin(a) * r)
		m.rotation.y = rng.randf_range(0, TAU)
		_add(root_node, m)
		placed += 1


func _rock_material() -> StandardMaterial3D:
	var m := StandardMaterial3D.new()
	m.albedo_texture = load("res://assets/textures/terrain/rock_face_03_alb_ht.png")
	m.normal_enabled = true
	m.normal_texture = load("res://assets/textures/terrain/rock_face_03_nrm_rgh.png")
	m.albedo_color = Color(0.72, 0.7, 0.68)
	m.roughness = 0.95
	# Triplanar: the texture is projected from the three axes and blended,
	# so it wraps any shape (CSG spheres have no useful UVs) without seams.
	m.uv1_triplanar = true
	m.uv1_scale = Vector3.ONE * 0.25
	return m


func _add(parent: Node, child: Node) -> void:
	parent.add_child(child, true)


func _pack() -> void:
	_set_owner(root_node, root_node)
	var scene := PackedScene.new()
	scene.pack(root_node)
	var err := ResourceSaver.save(scene, OUT)
	assert(err == OK, "failed to save " + OUT)
	root_node.free()


func _set_owner(node: Node, owner_node: Node) -> void:
	for c in node.get_children():
		c.owner = owner_node
		if c.scene_file_path == "":
			_set_owner(c, owner_node)
