[gd_scene format=3]

[ext_resource type="Script" path="res://ui/help_menu.gd" id="1_help"]
[ext_resource type="FontFile" path="res://assets/fonts/EBGaramond.ttf" id="2_font"]

[sub_resource type="Theme" id="MenuTheme"]
default_font = ExtResource("2_font")
default_font_size = 18
Label/colors/font_color = Color(0.97, 0.94, 0.87, 1)

[sub_resource type="StyleBoxFlat" id="PanelStyle"]
content_margin_left = 32.0
content_margin_top = 22.0
content_margin_right = 32.0
content_margin_bottom = 20.0
bg_color = Color(0.08, 0.07, 0.06, 0.92)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.93, 0.8, 0.55, 0.35)
corner_radius_top_left = 6
corner_radius_top_right = 6
corner_radius_bottom_right = 6
corner_radius_bottom_left = 6

[node name="HelpMenu" type="CanvasLayer"]
process_mode = 3
layer = 12
visible = false
script = ExtResource("1_help")

[node name="Root" type="Control" parent="."]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = SubResource("MenuTheme")

[node name="Dim" type="ColorRect" parent="Root"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0, 0, 0, 0.45)

[node name="Panel" type="PanelContainer" parent="Root"]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
grow_horizontal = 2
grow_vertical = 2
theme_override_styles/panel = SubResource("PanelStyle")

[node name="VBox" type="VBoxContainer" parent="Root/Panel"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="Root/Panel/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.93, 0.8, 0.55, 1)
theme_override_font_sizes/font_size = 30
text = "Controls"

[node name="Line" type="HSeparator" parent="Root/Panel/VBox"]
modulate = Color(1, 1, 1, 0.3)
layout_mode = 2

[node name="Columns" type="HBoxContainer" parent="Root/Panel/VBox"]
layout_mode = 2
theme_override_constants/separation = 48

[node name="Player" type="VBoxContainer" parent="Root/Panel/VBox/Columns"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="System" type="VBoxContainer" parent="Root/Panel/VBox/Columns"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Line2" type="HSeparator" parent="Root/Panel/VBox"]
modulate = Color(1, 1, 1, 0.3)
layout_mode = 2

[node name="Footer" type="Label" parent="Root/Panel/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.85, 0.82, 0.75, 0.7)
theme_override_font_sizes/font_size = 17
text = "H or Esc to close"
