script = ExtResource("14_m6886")
display_name = "Tobin"
lines = PackedStringArray("Name\'s Tobin. I cut wood for the village. Saw you hacking at the pines past the yard.", "Swing from the side, not straight down. Let the axe do the work.", "More folk are moving in, they say. We\'ll need a lot more timber.")
