script = ExtResource("14_m6886")
display_name = "Jory"
lines = PackedStringArray("Sit a while. Did I ever tell you about the winter the river froze solid?", "This well\'s older than the town. Older than me, even. Just.", "They say something under the old pines hums at night. I say there\'s ale under my bed.")
