script = ExtResource("14_m6886")
display_name = "Mira"
lines = PackedStringArray("Oh! You\'re the one from the big house up the road, aren\'t you? I\'m Mira.", "Most mornings I\'m at the market, if you\'re after apples. Don\'t tell Tobin where they came from.", "The forest gets dark early this time of year. Keep a lantern close.")
