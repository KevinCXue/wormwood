script = ExtResource("14_m6886")
display_name = "Anselm"
lines = PackedStringArray("Peace be with you, traveller. The doors are always open; the benches are always hard.", "We built this church stone by stone, hauled up that hill on our backs. Mostly Tobin\'s back.", "If something troubles you, come and sit. I\'m a good listener.")
