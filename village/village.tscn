script = ExtResource("14_m6886")
display_name = "Aldric"
lines = PackedStringArray("Aldric Penhallow, mayor of this town, for my sins. Welcome.", "Thirty souls, a market and a church on the hill. Not bad for a clearing in the woods.", "If you\'re staying, the town could use a strong arm. Come and see me once you\'ve settled in.")
